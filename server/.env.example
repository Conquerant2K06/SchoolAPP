# Backend (server/) — variables d'environnement
# Connexion PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret de signature des JWT (chaîne longue et aléatoire)
JWT_SECRET=change-me-with-a-long-random-secret
# Durée de validité du jeton (ex: 2h, 7d)
JWT_EXPIRES_IN=8h

# Origine autorisée du frontend Angular (CORS)
FRONTEND_ORIGIN=http://localhost:4200

# Port d'écoute du backend
PORT=3000

# Compte administrateur initial (créé par `npm run seed`)
SEED_ADMIN_EMAIL=admin@schoolci.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Administrateur
